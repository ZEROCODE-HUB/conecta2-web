<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no copiar ningún dato de la app ni a la nube ni a otro
     teléfono (allowBackup="false" no cubre el traspaso entre dispositivos). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
